# MongoDB 连接（认证库为 crawler，业务库用 pocoerp）
MONGODB_HOST=192.168.1.14
MONGODB_PORT=27017
MONGODB_DBNAME=crawler
MONGODB_USERNAME=your_username
MONGODB_PASSWORD=your_password

# 业务数据库名（默认 pocoerp，测试时用 pocoerp_test）
APP_DB_NAME=pocoerp

# 服务端口
PORT=3000

# JWT 密钥（生产环境务必修改）
JWT_SECRET=change-me-in-production
